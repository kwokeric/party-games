{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "party-games",
  "main": "party/index.ts",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": "./public"
  },
  "durable_objects": {
    "bindings": [
      { "name": "Lobby", "class_name": "Lobby" },
      { "name": "GuessTheSize", "class_name": "GuessTheSize" },
      { "name": "MatchTheColor", "class_name": "MatchTheColor" },
      { "name": "SecretHitler", "class_name": "SecretHitler" },
      { "name": "Telestrations", "class_name": "Telestrations" },
      { "name": "HuesAndClues", "class_name": "HuesAndClues" },
      { "name": "Imposter", "class_name": "Imposter" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Lobby", "GuessTheSize"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["MatchTheColor"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["SecretHitler"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["Telestrations"]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["HuesAndClues"]
    },
    {
      "tag": "v6",
      "new_sqlite_classes": ["Imposter"]
    }
  ]
}
