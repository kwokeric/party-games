{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "party-games",
  "main": "party/index.ts",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": "./public"
  },
  "durable_objects": {
    "bindings": [
      { "name": "Lobby", "class_name": "Lobby" },
      { "name": "GuessTheSize", "class_name": "GuessTheSize" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Lobby", "GuessTheSize"]
    }
  ]
}
